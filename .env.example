# Copier vers .env.local (non versionné) et renseigner.
#
# Seules les variables préfixées EXPO_PUBLIC_ sont exposées au bundle. Elles
# sont donc lisibles par quiconque décompile l'APK : n'y mettre aucun secret.
# Un client ID OAuth n'en est pas un — la sécurité repose sur la vérification
# de signature côté backend, pas sur le secret du client.

# URL de l'API. Sans valeur, le client tombe sur http://localhost/api/v1, ce
# qui échoue silencieusement sur un appareil physique.
EXPO_PUBLIC_API_URL=https://api.noble-bac-uemoa.tech/api/v1

# Connexion Google — client OAuth *web*, pas le client Android.
# Le SDK Android émet un id_token dont l'audience est le client web, et c'est
# cette audience que le backend vérifie. Sans cette variable, le bouton
# « Continuer avec Google » lève une erreur explicite au premier appui.
# Doit correspondre à GOOGLE_CLIENT_ID_WEB côté API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── Bypass de développement ──────────────────────────────────────────────────
# Sans effet en build de production : à n'utiliser qu'en local.

# Court-circuite le garde d'authentification et ouvre directement (tabs).
EXPO_PUBLIC_BYPASS_AUTH=false

# Fait accepter le code 000000 par l'écran OTP téléphone, à combiner avec
# TWILIO_BYPASS_OTP=true côté API.
EXPO_PUBLIC_BYPASS_OTP=false
